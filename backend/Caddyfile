{$DOMAIN} {
    # The VPN is the exam network boundary. Public HTTPS reaches this proxy
    # but receives 403; only clients in VPN_SUBNET can reach the API.
    @vpn remote_ip {$VPN_SUBNET}
    handle @vpn {
        # Students need activation, submission, and their own submission
        # status/report, and the VPN-only global leaderboard. Admin, health,
        # system status, and other routes remain unavailable to students.
        @allowed path /api/v1/vm-activation /api/v1/submissions /api/v1/submissions/* /api/v1/leaderboard
        handle @allowed {
            reverse_proxy api:8067
        }
        respond 404
    }

    respond 403
}

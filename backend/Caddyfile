{$DOMAIN} {
    encode zstd gzip
    header X-Content-Type-Options nosniff

    handle /api/* {
        reverse_proxy api:8067
    }

    # Organizer-editable scoreboard settings, backgrounds, and music,
    # mounted from SCOREBOARD_CONFIG_DIR. Revalidated so edits show up.
    handle_path /config/* {
        root * /srv/config
        header Cache-Control "no-cache"
        file_server
    }

    handle {
        root * /srv/scoreboard
        @assets path /assets/*
        header @assets Cache-Control "public, max-age=31536000, immutable"
        try_files {path} /index.html
        file_server
    }
}

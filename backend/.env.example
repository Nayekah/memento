# Copy this file to .env and fill in every empty value before starting the
# stack. .env holds secrets and must never be committed.

# Every student token is derived from this secret, so generate it once and
# keep it for the whole practicum.
#   openssl rand -base64 32
TOKEN_SECRET=
SUBMISSION_RATE_PER_MINUTE=8
# The password is placed in a connection URL, so use URL-safe characters.
#   openssl rand -hex 24
POSTGRES_PASSWORD=
WORK_DIR=/srv/memento/grader-work
DOMAIN=grader.example.edu
SCOREBOARD_CONFIG_DIR=./scoreboard-config
VPN_SUBNET=10.66.0.0/24
